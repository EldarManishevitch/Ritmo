{
  "name": "Song",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song title"
    },
    "artist": {
      "type": "string",
      "description": "Artist name"
    },
    "genre": {
      "type": "string",
      "enum": [
        "reggaeton",
        "bachata",
        "pop latino",
        "trap latino",
        "merengue",
        "salsa",
        "rock latino"
      ],
      "default": "reggaeton"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ],
      "default": "A1"
    },
    "youtube_id": {
      "type": "string",
      "description": "YouTube video ID for the IFrame player"
    },
    "album_art_url": {
      "type": "string",
      "description": "Thumbnail / album art URL"
    },
    "preview_seconds": {
      "type": "number",
      "default": 10
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "fetching_lyrics",
        "translating",
        "ready",
        "failed",
        "static"
      ],
      "default": "pending"
    },
    "sync_offset_seconds": {
      "type": "number",
      "default": 0,
      "description": "Global calibration offset for music videos"
    }
  },
  "required": [
    "title",
    "artist"
  ]
}