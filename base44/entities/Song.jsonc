{
  "name": "Song",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song title"
    },
    "artist": {
      "type": "string",
      "description": "Artist name"
    },
    "genre": {
      "type": "string",
      "enum": [
        "reggaeton",
        "bachata",
        "pop latino",
        "trap latino",
        "merengue",
        "salsa",
        "rock latino"
      ],
      "default": "reggaeton"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "beginner"
    },
    "cefr_level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "default": "A1",
      "description": "CEFR proficiency level of this song"
    },
    "youtube_id": {
      "type": "string",
      "description": "YouTube video ID for the IFrame player"
    },
    "album_art_url": {
      "type": "string",
      "description": "Thumbnail / album art URL"
    },
    "preview_seconds": {
      "type": "number",
      "default": 10
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_catalog_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether this song is part of the default seeded catalog"
    },
    "is_synced": {
      "type": "boolean",
      "default": false,
      "description": "Whether lyrics have been synced with timestamps"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "fetching_lyrics",
        "translating",
        "ready",
        "ready_synced",
        "ready_unsynced",
        "failed",
        "static"
      ],
      "default": "pending"
    },
    "sync_offset_seconds": {
      "type": "number",
      "default": 0,
      "description": "Global calibration offset for music videos"
    }
  },
  "required": [
    "title",
    "artist"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}