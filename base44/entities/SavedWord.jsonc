{
  "name": "SavedWord",
  "type": "object",
  "properties": {
    "word": {
      "type": "string",
      "description": "Spanish word saved by the user"
    },
    "english_meaning": {
      "type": "string",
      "description": "English translation"
    },
    "pronunciation_hint": {
      "type": "string"
    },
    "is_slang": {
      "type": "boolean",
      "default": false
    },
    "source_song_id": {
      "type": "string",
      "description": "FK to Song where the word was saved"
    },
    "mastered": {
      "type": "boolean",
      "default": false
    },
    "knowledge_level": {
      "type": "string",
      "enum": [
        "new",
        "known",
        "mastered"
      ],
      "default": "new",
      "description": "Knowledge level: new (no successful tries), known (1+ successful try), mastered (21 successful tries on different dates)"
    },
    "success_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Distinct YYYY-MM-DD dates on which the word was answered correctly"
    }
  },
  "required": [
    "word",
    "english_meaning"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}