{
  "name": "SavedWord",
  "type": "object",
  "properties": {
    "word": {
      "type": "string",
      "description": "Spanish word saved by the user"
    },
    "english_meaning": {
      "type": "string",
      "description": "English translation"
    },
    "pronunciation_hint": {
      "type": "string"
    },
    "is_slang": {
      "type": "boolean",
      "default": false
    },
    "source_song_id": {
      "type": "string",
      "description": "FK to Song where the word was saved"
    },
    "mastered": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "word",
    "english_meaning"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}