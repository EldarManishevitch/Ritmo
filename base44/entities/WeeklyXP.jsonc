{
  "name": "WeeklyXP",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string",
      "description": "YYYY-MM-DD \u2014 the Monday of the current week"
    },
    "xp_earned": {
      "type": "number",
      "default": 0,
      "description": "XP earned this week only, NOT cumulative"
    },
    "lessons_completed": {
      "type": "number",
      "default": 0,
      "description": "Daily lessons finished this week"
    },
    "songs_completed": {
      "type": "number",
      "default": 0,
      "description": "Songs finished this week"
    }
  },
  "required": [
    "week_start"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}