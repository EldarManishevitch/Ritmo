{
  "name": "DailyLesson",
  "type": "object",
  "properties": {
    "song_id": {
      "type": "string",
      "description": "FK to Song chosen as today's lesson"
    },
    "song_title": {
      "type": "string"
    },
    "song_artist": {
      "type": "string",
      "description": "Denormalized artist name"
    },
    "song_youtube_id": {
      "type": "string",
      "description": "Denormalized YouTube video ID"
    },
    "song_genre": {
      "type": "string",
      "description": "Denormalized genre"
    },
    "lesson_date": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD for this daily lesson"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "chorus_line_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "LyricLine IDs used in the quiz"
    },
    "quiz_score": {
      "type": "number",
      "default": 0,
      "description": "Quiz score out of 5"
    },
    "words_tapped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Spanish words the user tapped in Activity 1"
    },
    "streak_awarded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the streak was already awarded for this lesson"
    },
    "activity_step": {
      "type": "number",
      "default": 1,
      "description": "Which activity the user is currently on: 1, 2, or 3"
    }
  },
  "required": [
    "song_id",
    "lesson_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}