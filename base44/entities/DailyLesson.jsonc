{
  "name": "DailyLesson",
  "type": "object",
  "properties": {
    "song_id": {
      "type": "string",
      "description": "FK to Song chosen as today's lesson"
    },
    "song_title": {
      "type": "string"
    },
    "song_artist": {
      "type": "string",
      "description": "Artist of the lesson song"
    },
    "song_youtube_id": {
      "type": "string",
      "description": "YouTube video ID of the lesson song"
    },
    "song_genre": {
      "type": "string",
      "description": "Genre of the lesson song"
    },
    "lesson_date": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD for this daily lesson"
    },
    "chorus_line_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "LyricLine ids used for the lesson chorus activity"
    },
    "activity_step": {
      "type": "number",
      "default": 1,
      "description": "Current step in the daily lesson flow"
    },
    "quiz_score": {
      "type": "number",
      "default": 0,
      "description": "Score achieved on the lesson quiz"
    },
    "words_tapped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Words the user tapped during the lesson"
    },
    "streak_awarded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the streak has already been awarded for this lesson"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lesson was completed"
    }
  },
  "required": [
    "song_id",
    "lesson_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}