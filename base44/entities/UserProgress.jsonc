{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "xp": {
      "type": "number",
      "default": 0,
      "description": "Total experience points earned"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Current consecutive-day streak"
    },
    "best_streak": {
      "type": "number",
      "default": 0,
      "description": "Best streak ever reached"
    },
    "last_activity_date": {
      "type": "string",
      "description": "YYYY-MM-DD of the last completed quiz"
    },
    "songs_completed": {
      "type": "number",
      "default": 0,
      "description": "Total quizzes/songs fully completed"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ids of unlocked achievements"
    },
    "cefr_level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "default": "A1",
      "description": "Current CEFR proficiency level"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user completed the onboarding wizard"
    },
    "fav_genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User's favorite genres picked during onboarding"
    },
    "learning_goal": {
      "type": "string",
      "description": "User's primary learning goal"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Daily learning reminder toggle"
    },
    "notifications_time": {
      "type": "string",
      "default": "18:00",
      "description": "Preferred reminder time (HH:MM)"
    },
    "unlocked_conversations": {
      "type": "boolean",
      "default": true,
      "description": "Whether daily conversations feature is unlocked"
    },
    "user_email": {
      "type": "string",
      "description": "User's email for sending daily reminders"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}