{
  "name": "PronunciationAttempt",
  "type": "object",
  "properties": {
    "song_id": {
      "type": "string",
      "description": "FK to Song"
    },
    "line_index": {
      "type": "number",
      "description": "Which LyricLine was sung (-1 for single-word practice)"
    },
    "spanish_text": {
      "type": "string",
      "description": "The correct lyric line \u2014 denormalized"
    },
    "transcript": {
      "type": "string",
      "description": "What the user sang, from STT"
    },
    "word_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "matched_to": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Per-word scores from pronunciation scoring"
    },
    "overall_score": {
      "type": "number",
      "description": "0-100 overall score"
    },
    "attempt_number": {
      "type": "number",
      "default": 1,
      "description": "Multiple attempts on same line allowed"
    }
  },
  "required": [
    "song_id",
    "line_index"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}